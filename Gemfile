# source tells bundler where to download the gems from
source "https://rubygems.org"

gem "gosu"

# gem library that allows maps loaded from json files created in the Tiled level editor.
gem 'gosu_tiled'

# group tells Bundler these gems belong to the development and test groups
group :development, :test do
  gem "minitest"
  gem "debug"
  gem "rake"
end